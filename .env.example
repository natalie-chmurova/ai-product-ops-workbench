# Copy this file to ".env" and fill in your keys.

# Required — your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables reading the ClickUp board, the Board plan tab and the Apply plan button.
# Token: ClickUp → Settings → Apps → API Token (starts with pk_)
CLICKUP_API_TOKEN=pk_...
# CLICKUP_TEAM_ID, the workspace id, lets the app list the workspace's lists for the
# picker (and link to the board); CLICKUP_LIST_ID is the default list.
CLICKUP_LIST_ID=
CLICKUP_TEAM_ID=

# Optional — map extracted owner names to ClickUp user ids (Name:id,Name:id)
OWNER_ALIASES=
